# ============================================================
# .gitignore - 空气质量度量学习项目
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# 虚拟环境
venv/
env/
.env/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# 压缩包
*.zip
*.tar.gz
*.rar

# 日志和临时文件
*.log
*.tmp

# ============================================================
# 数据文件（原始Excel太大，不上传GitHub）
# ============================================================

# 排除 数据/raw/ 下所有文件，但保留样例和占位文件
数据/raw/*
!数据/raw/sample.xlsx
!数据/raw/.gitkeep

# ============================================================
# 以下内容需要上传（结果文件）
# ============================================================
# 图表/ - 上传（10张PNG）
# results/ - 上传（5个CSV）
# 数据/processed/ - 上传（合并结果）
# 数据/features/ - 上传（特征矩阵+聚类结果）
# 地图数据/*.gmt - 上传（边界数据，别人跑地图需要）
# 报告/ - 上传（分析报告）